# Cloudflare (for wrangler CLI)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# GitHub OAuth App (set as Worker secrets via `wrangler secret put`)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Stripe (set as Worker secrets via `wrangler secret put`)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PRO_PRICE_ID_EUR_10=

# npm (for publishing)
NPM_TOKEN=

# CLI config (optional, for local dev)
VANISH_API_KEY=
VANISH_API_URL=http://localhost:8787

# Optional privacy-light product analytics (filenames/content are never stored)
PRODUCT_EVENTS=false

# Optional PostHog web analytics (Worker vars). Leave unset to disable in local dev;
# production on vanish.sh falls back to the hosted public project key.
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
