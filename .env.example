# Cloudflare (for wrangler CLI)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# GitHub OAuth App (set as Worker secrets via `wrangler secret put`)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Stripe (set as Worker secrets via `wrangler secret put`)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# npm (for publishing)
NPM_TOKEN=

# CLI config (optional, for local dev)
VANISH_API_KEY=
VANISH_API_URL=http://localhost:8787

# Optional privacy-light product analytics (filenames/content are never stored)
PRODUCT_EVENTS=false
