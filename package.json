{
  "name": "vanish-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "tsc --noEmit -p packages/cli/tsconfig.json && tsc --noEmit -p packages/worker/tsconfig.json",
    "test": "vitest run",
    "dev:worker": "npm run dev --workspace=@vanish/worker",
    "dev:cli": "npm run dev --workspace=vanish-cli",
    "commit": "czg",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "czg": "^1.13.1",
    "husky": "^9.1.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
