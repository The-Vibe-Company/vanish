{
  "name": "@vanish/worker",
  "version": "0.1.22",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "db:bootstrap": "wrangler d1 execute vanish-db --local --file=src/db/schema.sql",
    "db:migrate": "wrangler d1 migrations apply vanish-db --local"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "hono": "^4.12.18",
    "nanoid": "^5.1.2",
    "tldts": "^7.4.9"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.3",
    "@cloudflare/workers-types": "^4.20260510.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5",
    "wrangler": "^4.90.0"
  }
}
